---
import styles from './ArrowLink.module.css';

interface Props {
  href: string;
  size?: 'small' | 'body' | 'lede';
  tone?: 'accent' | 'muted';
  // Let the link wrap across lines instead of forcing overflow (long emails).
  wrap?: boolean;
}
const { href, size = 'body', tone = 'accent', wrap = false } = Astro.props;
---

<a
  class:list={[
    styles['arrowLink'],
    size === 'small' && styles['isSmall'],
    size === 'lede' && styles['isLede'],
    tone === 'muted' && styles['isMuted'],
    wrap && styles['isWrap'],
  ]}
  href={href}
>
  <slot /><span class={styles['arrow']} aria-hidden="true">&rarr;</span>
</a>

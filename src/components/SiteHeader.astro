---
import { site } from '../site';
import styles from './SiteHeader.module.css';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  const clean = (href.split('#')[0] ?? '').replace(/\/$/, '');
  if (!clean) return false;
  return path === clean || path.startsWith(`${clean}/`);
}
---

<header class={styles['siteHeader']}>
  <div class:list={['container', styles['siteHeaderInner']]}>
    <Wordmark />
    <nav class={styles['nav']} aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[styles['navLink'], isActive(item.href) && styles['isActive']]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

---
import { site } from '../site';
import styles from './SiteFooter.module.css';
import TextLink from './TextLink.astro';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class={styles['siteFooter']}>
  <div class:list={['container', styles['siteFooterInner']]}>
    <div>
      <Wordmark soft />
      <p class={styles['siteFooterTag']}>
        Independent software studio. {site.author}.
      </p>
    </div>

    <nav class={styles['siteFooterNav']} aria-label="Footer">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>

    <div>
      <TextLink href={`mailto:${site.email}`}>{site.email}</TextLink>
    </div>
  </div>

  <div class:list={['container', styles['siteFooterBase']]}>
    <span>&copy; {year} {site.name}</span>
    <span>Built with care.</span>
  </div>
</footer>

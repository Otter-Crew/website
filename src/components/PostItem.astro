---
import styles from './PostItem.module.css';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  // h2 when the row sits directly under a page <h1> (the /blog list); h3 when
  // it sits under a section heading (the homepage "Recent writing" section).
  headingLevel?: 2 | 3;
}
const { title, description, slug, pubDate, headingLevel = 2 } = Astro.props;
const Title = headingLevel === 3 ? 'h3' : 'h2';
const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const iso = pubDate.toISOString().slice(0, 10);
---

<li class={styles['post']}>
  <div class={styles['postMeta']}>
    <time datetime={iso}>{date}</time>
  </div>
  <div>
    <Title class={styles['postTitle']}>
      <a class={styles['postLink']} href={`/blog/${slug}/`}>
        <span>{title}</span>
        <span class={styles['arrow']} aria-hidden="true">&rarr;</span>
      </a>
    </Title>
    <p class={styles['postDesc']}>{description}</p>
  </div>
</li>

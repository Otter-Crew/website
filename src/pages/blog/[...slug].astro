---
import { getCollection, render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import styles from './post.module.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead: string = remarkPluginFrontmatter['minutesRead'];

const date = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const iso = post.data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
>
  <article class={styles['post']}>
    <div class="container">
      <a class={styles['postBack']} href="/blog">
        <span aria-hidden="true">&larr;</span> Writing
      </a>

      <header class={styles['postHeader']}>
        <h1 class={styles['postTitle']}>{post.data.title}</h1>
        <p class={styles['postMeta']}>
          <time datetime={iso}>{date}</time>
          <span>{minutesRead}</span>
          {
            post.data.tags.length > 0 && (
              <span>{post.data.tags.join(' · ')}</span>
            )
          }
        </p>
      </header>

      <Prose>
        <Content />
      </Prose>
    </div>
  </article>
</BaseLayout>

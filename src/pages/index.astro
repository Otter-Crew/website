---
import { getCollection } from 'astro:content';
import ArrowLink from '../components/ArrowLink.astro';
import PostItem from '../components/PostItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Section from '../components/Section.astro';
import SectionMarker from '../components/SectionMarker.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import styles from './index.module.css';

const featured = (await getCollection('projects'))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Section top="2xl" bottom="xl">
    <p class={styles['heroStatus']}>
      <span class={styles['heroDot']} aria-hidden="true"></span>
      {site.availability}
    </p>
    <h1 class={styles['heroTitle']}>
      We make complex systems <em>legible</em> again.
    </h1>
    <div class={styles['heroFoot']}>
      <p class={styles['heroLede']}>
        otter-crew is an independent software studio. We consult for teams whose
        software has grown faster than anyone can follow, and build a few
        projects of our own.
      </p>
      <ArrowLink href="/consulting" size="lede">Start a conversation</ArrowLink>
    </div>
  </Section>

  {
    featured.length > 0 && (
      <Section labelledby="work-marker" top="2xl" bottom="lg">
        <div class={styles['sectionHead']}>
          <SectionMarker id="work-marker" as="h2">
            Selected work
          </SectionMarker>
          <ArrowLink href="/projects" size="small" tone="muted">
            All work
          </ArrowLink>
        </div>
        <ul role="list">
          {featured.map((p) => (
            <ProjectItem
              title={p.data.title}
              summary={p.data.summary}
              year={p.data.year}
              status={p.data.status}
              role={p.data.role}
              link={p.data.link}
              headingLevel={3}
            />
          ))}
        </ul>
      </Section>
    )
  }

  {
    posts.length > 0 && (
      <Section labelledby="writing-marker" top="lg" bottom="2xl">
        <div class={styles['sectionHead']}>
          <SectionMarker id="writing-marker" as="h2">
            Recent writing
          </SectionMarker>
          <ArrowLink href="/blog" size="small" tone="muted">
            All writing
          </ArrowLink>
        </div>
        <ul role="list">
          {posts.map((post) => (
            <PostItem
              title={post.data.title}
              description={post.data.description}
              slug={post.id}
              pubDate={post.data.pubDate}
              headingLevel={3}
            />
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="contact" labelledby="contact-marker" top="2xl" bottom="xl">
    <SectionMarker id="contact-marker" as="h2">Contact</SectionMarker>
    <p class={styles['contactLead']}>
      Have a system that has grown hard to reason about? That is the work we do
      best.
    </p>
    <p class={styles['contactLine']}>Tell us what you are building.</p>
    <p class={styles['contactEmail']}>
      <ArrowLink href={`mailto:${site.email}`} size="lede" wrap>
        {site.email}
      </ArrowLink>
    </p>
  </Section>
</BaseLayout>
